{
    "manifest_version": 3,
    "name": "suicidebooth",
    "description": "Erase your social media profiles",
    "version": "0.1.0",
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.facebook.com/*",
                "http://*.facebook.com/*"
            ],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "permissions": ["storage", "activeTab"],
    "host_permissions": [
        "https://*.facebook.com/*",
        "http://*.facebook.com/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
